---
apiVersion: v1
kind: Service
metadata:
  name: {{ _name }}-gateway
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
{% if gateway.service_annotations is defined %}
  # Used to publish the platform's name to whatever watches Services -- with
  # external-dns that is external-dns.alpha.kubernetes.io/hostname.
  annotations:
{{ gateway.service_annotations | to_nice_yaml(indent=2) | indent(4, True) }}
{% endif %}
spec:
  # ClusterIP by default: the platform is reachable in-cluster and nothing
  # assumes an address the cluster cannot hand out. Set LoadBalancer to give
  # the front door its own IP -- envoy terminates TLS on 443 itself, so it
  # wants a real address rather than an HTTP proxy in front of it.
  type: {{ gateway.service_type | default('ClusterIP') }}
  selector:
    app.kubernetes.io/name: {{ _name }}-gateway
  ports:
    - name: https
      port: 443
      targetPort: {{ _envoy_https_port }}
    - name: gateway
      port: {{ _gw_nginx_port }}
      targetPort: {{ _gw_nginx_port }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ _name }}-gateway
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  replicas: {{ gateway.replicas | default(1) }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ _name }}-gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ _name }}-gateway
        app.kubernetes.io/managed-by: ace-operator
    spec:
      automountServiceAccountToken: false

      # The gateway image runs as uid 1000 / gid 0 and expects group-root
      # write on its own directories, which is how it stays runnable under an
      # arbitrary uid.
      securityContext:
        runAsUser: 1000
        fsGroup: 0

      # Migrations run once, in an init container, and the long-running
      # container then only supervises processes. This is the vendor's own
      # split, and it is what makes the Deployment safe to restart: nothing in
      # the main container mutates the schema.
      initContainers:
        - name: migrate
          image: {{ _gateway_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          command: ["aap-gateway-manage", "migrate", "--noinput"]
          env: &gwenv
            - name: DJANGO_SETTINGS_MODULE
              value: aap_gateway_api.settings
            - name: GATEWAY_SECRET_KEY_FILE
              value: /etc/ace/secrets/gateway_secret_key
            - name: DATABASE_ENGINE
              value: django.db.backends.postgresql
            - name: DATABASE_HOST
              valueFrom: {secretKeyRef: {name: {{ _name }}-gateway-pg, key: host}}
            - name: DATABASE_PORT
              valueFrom: {secretKeyRef: {name: {{ _name }}-gateway-pg, key: port}}
            - name: DATABASE_NAME
              valueFrom: {secretKeyRef: {name: {{ _name }}-gateway-pg, key: database}}
            - name: DATABASE_USER
              valueFrom: {secretKeyRef: {name: {{ _name }}-gateway-pg, key: username}}
            - name: DATABASE_PASSWORD
              valueFrom: {secretKeyRef: {name: {{ _name }}-gateway-pg, key: password}}
            - name: REDIS_MODE
              value: standalone
            - name: REDIS_URL
              value: redis://{{ _name }}-redis:6379/0
            # migrate_service_data calls each component back through envoy over
            # HTTPS, so the gateway has to trust the certificate envoy presents.
            # Without this it fails with CERTIFICATE_VERIFY_FAILED against its
            # own front door, and no organization ever reaches the controller.
            - name: REQUESTS_CA_BUNDLE
              value: /etc/ace/tls/gateway.crt
          volumeMounts: &gwmounts
            - {name: config, mountPath: /etc/ansible-automation-platform/gateway/settings.py, subPath: settings.py}
            - {name: config, mountPath: /etc/ansible-automation-platform/gateway/uwsgi.ini, subPath: uwsgi.ini}
            - {name: config, mountPath: /etc/ansible-automation-platform/gateway/nginx.conf, subPath: nginx.conf}
            - {name: config, mountPath: /etc/supervisord.conf, subPath: supervisord.conf}
            - {name: secrets, mountPath: /etc/ace/secrets, readOnly: true}
            - {name: tls, mountPath: /etc/ace/tls, readOnly: true}
            - {name: run, mountPath: /var/run/supervisor}

      containers:
        - name: gateway
          image: {{ _gateway_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          env: *gwenv
          volumeMounts: *gwmounts
          ports:
            - {name: nginx, containerPort: {{ _gw_nginx_port }}}
            - {name: grpc, containerPort: {{ _gw_grpc_port }}}
          readinessProbe:
            httpGet:
              path: /api/gateway/v1/ping/
              port: {{ _gw_nginx_port }}
            # A cold gateway answers its first ping in several seconds: uwsgi
            # loads the WSGI app, then the ping itself hits the database. The
            # probe's default 1s timeout cut that off every time, and nginx
            # logged the probe as 499 (client closed request) while the app
            # was working perfectly -- so the pod never went Ready and the
            # rollout wedged with the previous pod still serving.
            initialDelaySeconds: 45
            periodSeconds: 15
            timeoutSeconds: 10
            failureThreshold: 30

        # Same pod, so envoy reaches the gateway's gRPC control plane and nginx
        # on 127.0.0.1 — the identical wiring the podman host gets from
        # network: host, without needing the host's network.
        - name: envoy
          image: {{ _envoy_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          args: ["-c", "/etc/envoy/envoy.yaml", "--service-cluster", "ace"]
          volumeMounts:
            - {name: envoy-config, mountPath: /etc/envoy}
            # The path is not ours to choose: the gateway names it in the
            # listener it programs over xDS, so envoy must find it there.
            - {name: tls, mountPath: /etc/ansible-automation-platform/gateway, readOnly: true}
          ports:
            - {name: https, containerPort: {{ _envoy_https_port }}}

      volumes:
        - name: config
          configMap: {name: {{ _name }}-gateway-config}
        - name: envoy-config
          configMap: {name: {{ _name }}-envoy-config}
        - name: tls
          secret:
            secretName: {{ _name }}-gateway-tls
            items:
              - {key: tls.crt, path: gateway.crt}
              - {key: tls.key, path: gateway.key}
        - name: run
          emptyDir: {}
        - name: secrets
          projected:
            sources:
              - secret:
                  name: {{ _name }}-gateway-secret
                  items: [{key: secret_key, path: gateway_secret_key}]
