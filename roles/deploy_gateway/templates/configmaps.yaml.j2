---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-gateway-config
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  settings.py: |
    # Managed by ace-operator. Layered on top of jewel's own defaults.
    ALLOWED_HOSTS = ['*']
    CSRF_TRUSTED_ORIGINS = ['{{ _external_url }}']
    FRONT_END_URL = '{{ _external_url }}'

    # Envoy pulls its listeners and clusters from this gRPC control plane.
    # GRPC_SERVER_PORT must be a string: jewel concatenates it into the bind
    # address rather than formatting it.
    ENVOY_HOSTNAME = '127.0.0.1'
    GRPC_SERVER_PORT = '{{ _gw_grpc_port }}'
    GRPC_SERVER_PROCESSES = 2

  uwsgi.ini: |
    [uwsgi]
    ; larger than the 4kB default so fat SSO auth headers fit
    buffer-size = 10240
    socket = 127.0.0.1:{{ _gw_uwsgi_port }}
    processes = 3
    master = true
    vacuum = true
    no-orphans = true
    lazy-apps = true
    enable-threads = true
    manage-script-name = true
    harakiri = 60
    harakiri-graceful-timeout = 5
    harakiri-graceful-signal = 6
    py-call-osafterfork = true
    mount = /=aap_gateway_api.wsgi:application

  nginx.conf: |
    worker_processes 1;
    # /var/run is not writable by uid 1000 in a pod, so nginx cannot drop its
    # pid file in the default place — it exits with "Permission denied" and
    # supervisor gives up on it, while every other process starts fine. The
    # emptyDir below is the one writable path this container has.
    pid /var/run/supervisor/nginx.pid;
    error_log /dev/stderr;
    events { worker_connections 1024; }
    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;
      access_log /dev/stdout;
      sendfile on;
      client_max_body_size 5m;

      # Same reason: every scratch path nginx may write to has to live there.
      client_body_temp_path /var/run/supervisor/nginx-client-body;
      proxy_temp_path       /var/run/supervisor/nginx-proxy;
      fastcgi_temp_path     /var/run/supervisor/nginx-fastcgi;
      uwsgi_temp_path       /var/run/supervisor/nginx-uwsgi;
      scgi_temp_path        /var/run/supervisor/nginx-scgi;

      upstream uwsgi { server 127.0.0.1:{{ _gw_uwsgi_port }}; }

      server {
        listen {{ _gw_nginx_port }};
        server_name _;

        # Static assets and the console are baked into the image at build time.
        location ^~ /static/ {
          alias /var/lib/ansible-automation-platform/platform/ui/static/;
        }

        location ~* /(v3|api|o|\.well-known)/ {
          uwsgi_pass uwsgi;
          uwsgi_read_timeout 120s;
          include /etc/nginx/uwsgi_params;
        }

        location ~* \.(json|woff|woff2|jpe?g|png|gif|ico|svg|css|js)$ {
          root /var/lib/ansible-automation-platform/platform/ui;
          add_header Cache-Control "public, max-age=31536000, immutable";
          try_files $uri =404;
          gzip_static on;
        }

        location / {
          root /var/lib/ansible-automation-platform/platform/ui;
          autoindex off;
          expires off;
          add_header Cache-Control "public, max-age=0, must-revalidate" always;
          try_files $uri /index.html =404;
        }
      }
    }

  supervisord.conf: |
    # Production process set: nginx, uwsgi, the gRPC control plane, dispatcher.
    # No auto-reload or runserver — those are jewel development conveniences.
    [supervisord]
    umask = 022
    minfds = 4096
    nodaemon = true
    pidfile = /var/run/supervisor/supervisord.pid
    logfile = /dev/stdout
    logfile_maxbytes = 0
    childlogdir = /var/log/supervisor

    [program:nginx]
    command = nginx -g "daemon off;" -c /etc/ansible-automation-platform/gateway/nginx.conf
    autorestart = true
    stopasgroup = true
    killasgroup = true
    stdout_logfile = /dev/stdout
    stdout_logfile_maxbytes = 0
    stderr_logfile = /dev/stderr
    stderr_logfile_maxbytes = 0

    [program:uwsgi]
    command = /opt/aap-gateway/venv/bin/uwsgi /etc/ansible-automation-platform/gateway/uwsgi.ini
    autorestart = true
    stopwaitsecs = 5
    stopsignal = KILL
    stopasgroup = true
    killasgroup = true
    stdout_logfile = /dev/stdout
    stdout_logfile_maxbytes = 0
    stderr_logfile = /dev/stderr
    stderr_logfile_maxbytes = 0

    [program:control-plane]
    command = /usr/bin/aap-gateway-manage start_grpc_server
    autorestart = true
    stopwaitsecs = 5
    stopsignal = KILL
    stopasgroup = true
    killasgroup = true
    stdout_logfile = /dev/stdout
    stdout_logfile_maxbytes = 0
    stderr_logfile = /dev/stderr
    stderr_logfile_maxbytes = 0

    [program:dispatcher]
    command = /usr/bin/aap-gateway-manage dispatcherd
    autorestart = true
    stopasgroup = true
    killasgroup = true
    stdout_logfile = /dev/stdout
    stdout_logfile_maxbytes = 0
    stderr_logfile = /dev/stderr
    stderr_logfile_maxbytes = 0

    [group:gateway-processes]
    programs = nginx,uwsgi,control-plane,dispatcher
    priority = 5

    [unix_http_server]
    file = /var/run/supervisor/supervisor.sock

    [supervisorctl]
    serverurl = unix:///var/run/supervisor/supervisor.sock

    [rpcinterface:supervisor]
    supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-envoy-config
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  # The gateway's listener references this script by absolute path inside the
  # proxy container, so it has to exist there or every LDS update is rejected
  # with "Invalid path: /etc/envoy/envoy-path-rewrite.lua". It rewrites service
  # paths in response bodies and Location headers, so a component's own URLs
  # come back as gateway URLs.
  envoy-path-rewrite.lua: |
    -- Vendored from ansible/jewel (Apache-2.0), tools/scripts/envoy-path-rewrite.lua
    -- at ref cd1fd8e657f873f2b7c328cf3acc8696f23fb2ed — the gateway's LDS listener config
    -- references this script inside the proxy container.
    function envoy_on_response(handle)
        -- This script rewrites urls in the response by replacing the service base path
        -- in Location headers and in the request body.
        -- ex: translates /service-path/galaxy/ to /gateway-path/hub/ in service response bodies
        handle:logDebug("Running lua script to rewrite response body.")
        -- Ignore this script if the response is an upgrade response to prevent websockets from breaking
        local status_code = handle:headers():get(":status")
        if status_code == "101" then
            return
        end

        -- Ignore this script if the response is from a StreamingHTTPResponse event-stream
        local ctype = handle:headers():get("content-type")
        if ctype and string.match(ctype, "text/event%-stream") then
            handle:headers():replace("X-Accel-Buffering", "no")
            return
        end

        local location = handle:headers():get("Location")

        -- If the location contains __gateway_no_rewrite__=1 (e.g. as a GET param),
        -- then do not rewrite the location header.
        if location and string.match(location, "__gateway_no_rewrite__=1") then
            return
        end

        local prefix_rewrite = handle:metadata():get("prefix")
        local prefix = handle:metadata():get("prefix_rewrite")

        if location then
            local new_location = string.gsub(location, prefix, prefix_rewrite)
            handle:headers():replace("Location", new_location)
        end
        local body = handle:body()
        if body then
            body_bytes = body:getBytes(0, body:length())
            local modified_body = string.gsub(body_bytes, prefix, prefix_rewrite)

            local content_length = handle:body():setBytes(modified_body)
            handle:headers():replace("content-length", content_length)
        end
    end

    function envoy_on_request(handle)
        -- Translate urls in the request body back to the service's base path.
        -- ex: translates /gateway-path/hub/ to /service-path/galaxy/ in service request bodies
        handle:logDebug("Running lua script to rewrite request body.")

        -- Ignore this script if the request is an upgrade request to prevent websockets from breaking
        local upgrade_header = handle:headers():get("upgrade")
        if upgrade_header then
            return
        end

        local prefix_rewrite = handle:metadata():get("prefix")
        local prefix = handle:metadata():get("prefix_rewrite")

        local path = handle:headers():get(":path")
        if string.match(path, "=") then
            -- need to escape "-"
            local match = "%=" .. string.gsub(prefix_rewrite, "%-", "%%-")
            local replace = "%=" .. string.gsub(prefix, "%-", "%%-")

            handle:logDebug(match)
            handle:logDebug(replace)

            local new_path = string.gsub(path, match, replace)

            -- if the query param is urlencoded, replace those instead
            new_path = string.gsub(new_path, string.gsub(match, "/", "%%%%2F"), string.gsub(replace, "/", "%%%%2F"))

            handle:headers():replace(":path", new_path)
        end

        local body = handle:body()
        if body then
            body_bytes = body:getBytes(0, body:length())
            local modified_body = string.gsub(body_bytes, prefix_rewrite, prefix)

            local content_length = handle:body():setBytes(modified_body)
            handle:headers():replace("content-length", content_length)
        end
    end
  envoy.yaml: |
    # No static listeners. The gateway programs its own front door: listeners
    # and clusters are fetched from its xDS endpoints, so a route exists
    # because a component registered itself, not because it was written here.
    #
    # xDS is REST, served by the gateway's nginx at /v3/discovery:*. The gRPC
    # control plane on {{ _gw_grpc_port }} is a different thing entirely —
    # ext_authz — and pointing LDS/CDS at it yields
    #   gRPC config stream to xds_cluster closed: 12, Method not implemented
    # on a loop, with envoy never opening a listener at all.
    node:
      id: ace
      cluster: gateway

    dynamic_resources:
      lds_config:
        resource_api_version: V3
        api_config_source:
          api_type: REST
          transport_api_version: V3
          cluster_names: [gateway-control-plane-rest]
          refresh_delay: 5s
      cds_config:
        resource_api_version: V3
        api_config_source:
          api_type: REST
          transport_api_version: V3
          cluster_names: [gateway-control-plane-rest]
          refresh_delay: 5s

    static_resources:
      clusters:
        # The gateway API behind its own nginx. Plain HTTP: this hop is inside
        # one pod's network namespace.
        - name: gateway-control-plane-rest
          type: STRICT_DNS
          connect_timeout: 5s
          load_assignment:
            cluster_name: gateway-control-plane-rest
            endpoints:
              - lb_endpoints:
                  - endpoint:
                      address:
                        socket_address: {address: 127.0.0.1, port_value: {{ _gw_nginx_port }}}

        # gRPC control plane: per-request authorization, HTTP/2.
        - name: gateway_control_plane
          type: STRICT_DNS
          connect_timeout: 5s
          typed_extension_protocol_options:
            envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
              "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
              explicit_http_config:
                http2_protocol_options: {}
          load_assignment:
            cluster_name: gateway_control_plane
            endpoints:
              - lb_endpoints:
                  - endpoint:
                      address:
                        socket_address: {address: 127.0.0.1, port_value: {{ _gw_grpc_port }}}

    admin:
      address:
        socket_address: {address: 127.0.0.1, port_value: 9901}
