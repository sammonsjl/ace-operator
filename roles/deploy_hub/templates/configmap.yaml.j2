---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-hub-nginx
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  nginx.conf: |
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;
    worker_processes 1;
    events { worker_connections 1024; }
    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;
      # Everything writable moves under /tmp: this runs as a non-root uid that
      # cannot write nginx's defaults under /var.
      client_body_temp_path /tmp/client_body;
      proxy_temp_path /tmp/proxy;
      fastcgi_temp_path /tmp/fastcgi;
      uwsgi_temp_path /tmp/uwsgi;
      scgi_temp_path /tmp/scgi;

      # The platform terminates TLS at envoy, so trust its forwarded scheme.
      map $http_x_forwarded_proto $trusted_proto { default $scheme; https https; http http; }

      upstream pulp-api     { server {{ _name }}-hub-api-svc:{{ _hub_api_port }}; }
      upstream pulp-content { server {{ _name }}-hub-content-svc:{{ _hub_content_port }}; }

      server {
        listen {{ _hub_web_port }} default_server;
        server_name $hostname;
        client_max_body_size 0;
        proxy_read_timeout 120s;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;

        # Artifact downloads are served by the content app, not the API. This
        # is the path CONTENT_ORIGIN hands out, so it has to resolve here.
        location /pulp/content/ {
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $trusted_proto;
          proxy_set_header Host $http_host;
          proxy_redirect off;
          proxy_pass http://pulp-content;
        }

        location / {
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $trusted_proto;
          proxy_set_header Host $http_host;
          proxy_redirect off;
          proxy_pass http://pulp-api;
        }
      }
    }
