---
apiVersion: v1
kind: Service
metadata:
  name: {{ _name }}-postgres
  namespace: {{ _namespace }}
spec:
  clusterIP: None
  selector:
    app.kubernetes.io/name: {{ _name }}-postgres
  ports:
    - port: 5432
      targetPort: 5432
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ _name }}-postgres
  namespace: {{ _namespace }}
spec:
  serviceName: {{ _name }}-postgres
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ _name }}-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ _name }}-postgres
    spec:
      containers:
        - name: postgres
          image: {{ _pg_image }}
          ports:
            - containerPort: 5432
          env:
            - name: POSTGRES_USER
              valueFrom: {secretKeyRef: {name: {{ _name }}-postgres, key: username}}
            - name: POSTGRES_PASSWORD
              valueFrom: {secretKeyRef: {name: {{ _name }}-postgres, key: password}}
            # The component databases are created by their own operators; this
            # only has to exist so the server starts with something.
            - name: POSTGRES_DB
              value: postgres
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "postgres"]
            initialDelaySeconds: 10
            periodSeconds: 5
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: {{ postgres.storage_size | default('20Gi') }}
