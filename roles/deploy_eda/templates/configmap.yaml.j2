---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-eda-config
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  # EDA reads settings from the environment with an EDA_ prefix and __ for
  # nesting -- it is dynaconf, not a settings file.
  EDA_DEPLOYMENT_TYPE: "k8s"
  EDA_ALLOWED_HOSTS: "['*']"
  EDA_STATIC_URL: "/api/eda/static/"
  EDA_CONTROLLER_URL: "{{ eda.automation_server_url | default('http://' ~ _name ~ '-controller-service.' ~ _namespace ~ '.svc') }}"
  EDA_CONTROLLER_SSL_VERIFY: "no"
  EDA_WEBSOCKET_BASE_URL: "ws://{{ _name }}-eda-daphne.{{ _namespace }}.svc:{{ _eda_daphne_port }}"
  EDA_WEBSOCKET_TOKEN_BASE_URL: "http://{{ _name }}-eda-api.{{ _namespace }}.svc:{{ _eda_web_port }}"
  EDA_WEBSOCKET_SSL_VERIFY: "no"
  EDA_MAX_RUNNING_ACTIVATIONS: "12"
  EDA_DEFAULT_QUEUE_TIMEOUT: "300"

  # The gateway owns identity. http to the internal Service, so there is no
  # certificate to validate on either side.
  EDA_ANSIBLE_BASE_JWT_KEY: "{{ _gw_internal_url }}"
  EDA_ANSIBLE_BASE_JWT_VALIDATE_CERT: "false"
  EDA_ANSIBLE_BASE_JWT_REDIRECT_TYPE: "eda"
  EDA_RESOURCE_SERVER__URL: "{{ _gw_internal_url }}"
  EDA_RESOURCE_SERVER__SECRET_KEY: "{{ _service_secret_map['eda'] }}"
  EDA_RESOURCE_SERVER__VALIDATE_HTTPS: "false"
{% for s in eda.extra_settings | default([]) %}
  {{ s.setting | upper }}: "{{ s.value }}"
{% endfor %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-eda-nginx
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  nginx.conf: |
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;
    worker_processes 1;
    events { worker_connections 1024; }
    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;
      client_body_temp_path /tmp/client_body;
      proxy_temp_path /tmp/proxy;
      fastcgi_temp_path /tmp/fastcgi;
      uwsgi_temp_path /tmp/uwsgi;
      scgi_temp_path /tmp/scgi;
      map $http_upgrade $connection_upgrade { default upgrade; '' close; }
      server {
        listen {{ _eda_web_port }} default_server;
        client_max_body_size 0;
        # Websockets are a separate process from the API, and the activation
        # workers stream job output over them.
        location /api/eda/ws/ {
          proxy_pass http://127.0.0.1:{{ _eda_daphne_port }};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade;
          proxy_set_header Host $http_host;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        location / {
          proxy_pass http://127.0.0.1:{{ _eda_api_port }};
          proxy_set_header Host $http_host;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
          proxy_redirect off;
        }
      }
    }
