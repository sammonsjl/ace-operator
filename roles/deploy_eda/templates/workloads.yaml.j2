  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
    app.kubernetes.io/name: {{ _name }}-eda-scheduler
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: {{ _name }}-eda-scheduler}
  template:
    metadata:
      labels:
{{ _labels | to_nice_yaml(indent=2) | indent(8, True) }}
        app.kubernetes.io/name: {{ _name }}-eda-scheduler
    spec:
      initContainers:
        - name: wait-for-migrations
          image: {{ _eda_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          command: ["/bin/bash", "-c", "until aap-eda-manage migrate --check >/dev/null 2>&1; do echo waiting for the schema; sleep 5; done"]
          envFrom: [{configMapRef: {name: {{ _name }}-eda-config}}]
          env:
{{ db_env() }}
      containers:
        - name: scheduler
          image: {{ _eda_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          command: ["/bin/bash", "-c", "aap-eda-manage scheduler"]
          envFrom: [{configMapRef: {name: {{ _name }}-eda-config}}]
          env:
{{ db_env() }}
          resources:
            requests: {cpu: 50m, memory: 256Mi}
