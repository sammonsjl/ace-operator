{% import '_common.j2' as c with context %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ _name }}-controller-web
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
    app.kubernetes.io/name: {{ _name }}-controller-web
spec:
  replicas: {{ controller.replicas | default(1) }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ _name }}-controller-web
  template:
    metadata:
      labels:
{{ _labels | to_nice_yaml(indent=2) | indent(8, True) }}
        app.kubernetes.io/name: {{ _name }}-controller-web
      annotations:
        # Roll the pods when settings change. Django reads them once at
        # startup, so a rewritten ConfigMap under a running pod does nothing.
        ace.io/settings-checksum: "{{ lookup('template', 'settings.yaml.j2') | hash('sha1') }}"
    spec:
      serviceAccountName: {{ _name }}-controller
      containers:
{{ c.redis_sidecar() }}
        - name: web
          image: {{ _controller_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          args: ["/usr/bin/launch_awx_web.sh"]
          ports:
            - {name: http, containerPort: {{ _ctl_web_port }}}
          env:
{{ c.db_env() }}
          volumeMounts:
{{ c.app_mounts() }}
            - {name: config, mountPath: /etc/nginx/nginx.conf, subPath: nginx.conf}
            - {name: config, mountPath: /etc/tower/uwsgi.ini, subPath: uwsgi.ini}
            - {name: tmp, mountPath: /tmp}
          readinessProbe:
            httpGet: {path: /api/controller/v2/ping/, port: {{ _ctl_web_port }}}
            initialDelaySeconds: 20
            periodSeconds: 10
            # A cold Django answers its first request in several seconds; the
            # default 1s timeout cuts that off and the pod never goes ready.
            timeoutSeconds: 10
            failureThreshold: 30
          resources:
            {{ controller.web_resources | default({'requests': {'cpu': '100m', 'memory': '512Mi'}}) | to_json }}
        - name: rsyslog
          image: {{ _controller_image }}
          imagePullPolicy: {{ image_pull_policy | default('Always') }}
          args: ["/usr/bin/launch_awx_rsyslog.sh"]
          env:
{{ c.db_env() }}
          volumeMounts:
{{ c.app_mounts() }}
          resources:
            requests: {cpu: 10m, memory: 64Mi}
      volumes:
{{ c.volumes() }}
