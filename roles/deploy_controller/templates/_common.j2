{#- Shared pieces for the controller's pods: the database environment, the
    settings/secret mounts, and the volume set. Kept in one include so web,
    task and the migration Job cannot drift apart. -#}
{% macro db_env() %}
            # AWX reads the database from credentials.py, not the environment.
            # Only the pod's own identity comes in this way.
            - name: MY_POD_UID
              valueFrom: {fieldRef: {fieldPath: metadata.uid}}
            # AWX_CONTAINER_GROUP_DEFAULT_NAMESPACE reads this, and falls back
            # to "default" without it -- container-group jobs then try to
            # create their pod in the wrong namespace and are refused:
            #   pods is forbidden: User "system:serviceaccount:ace:ace-controller"
            #   cannot create resource "pods" in the namespace "default"
            - name: MY_POD_NAMESPACE
              valueFrom: {fieldRef: {fieldPath: metadata.namespace}}
{% endmacro %}
{% macro app_mounts() %}
            - {name: settings, mountPath: {{ _ctl_settings_dir }}/settings.py, subPath: settings.py}
            - {name: credentials, mountPath: {{ _ctl_settings_dir }}/credentials.py, subPath: credentials.py}
            - {name: credentials, mountPath: {{ _ctl_settings_dir }}/execution_environments.py, subPath: execution_environments.py}
            - {name: secret-key, mountPath: /etc/tower/SECRET_KEY, subPath: SECRET_KEY}
            - {name: redis-socket, mountPath: /var/run/redis}
            - {name: rsyslog-socket, mountPath: /var/run/awx-rsyslog}
{% endmacro %}
{% macro volumes() %}
        - name: settings
          configMap: {name: {{ _name }}-controller-settings}
        - name: credentials
          secret: {secretName: {{ _name }}-controller-credentials}
        - name: config
          configMap: {name: {{ _name }}-controller-config}
        - name: secret-key
          secret:
            secretName: {{ _name }}-controller-secret-key
            items: [{key: secret_key, path: SECRET_KEY}]
        - name: redis-socket
          emptyDir: {}
        - name: redis-data
          emptyDir: {}
        - name: rsyslog-socket
          emptyDir: {}
        # nginx and uwsgi both need somewhere writable; the image's defaults
        # under /var are not writable by the uid these run as.
        - name: tmp
          emptyDir: {}
        # The synced git checkouts. Shared between the task container, which
        # writes them, and receptor, which reads them when bundling work for a
        # container-group job -- without that the job pod gets an empty project
        # and ansible-playbook reports the playbook could not be found.
        - name: projects
          emptyDir: {}
{% endmacro %}
{% macro redis_sidecar() %}
        - name: redis
          image: {{ _redis_image }}
          imagePullPolicy: {{ image_pull_policy | default('IfNotPresent') }}
          args: [redis-server, /etc/redis.conf]
          volumeMounts:
            - {name: config, mountPath: /etc/redis.conf, subPath: redis.conf}
            - {name: redis-socket, mountPath: /var/run/redis}
            - {name: redis-data, mountPath: /data}
          resources:
            requests: {cpu: 10m, memory: 64Mi}
{% endmacro %}
