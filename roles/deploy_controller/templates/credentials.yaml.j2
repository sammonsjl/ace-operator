---
# AWX splits its configuration across several files in /etc/tower/conf.d, and
# the database belongs in this one because it carries the password. The engine
# is AWX's own profiled_pg rather than Django's postgresql backend, and the
# cache, broker and channel layers are deliberately absent: AWX's defaults
# already point them at the redis unix socket the sidecar provides. Setting
# them here instead is how the migration Job ended up asking for a
# django_redis backend the image does not ship.
apiVersion: v1
kind: Secret
metadata:
  name: {{ _name }}-controller-credentials
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
stringData:
  credentials.py: |
    DATABASES = {
        'default': {
            'ATOMIC_REQUESTS': True,
            'ENGINE': 'awx.main.db.profiled_pg',
            'NAME': "{{ _ctl_pg.database }}",
            'USER': "{{ _ctl_pg.username }}",
            'PASSWORD': "{{ _ctl_pg.password }}",
            'HOST': '{{ _ctl_pg.host }}',
            'PORT': "{{ _ctl_pg.port }}",
            'OPTIONS': {'sslmode': '{{ _ctl_pg.sslmode | default('prefer') }}'},
        }
    }

    # The dispatcher holds a long-lived LISTEN/NOTIFY connection; without
    # keepalives it dies silently behind a NAT or an idle timeout and jobs
    # simply stop being picked up.
    LISTENER_DATABASES = {
        'default': {
            'OPTIONS': {
                'keepalives': 1,
                'keepalives_idle': 5,
                'keepalives_interval': 5,
                'keepalives_count': 5,
            },
        }
    }

    BROADCAST_WEBSOCKET_SECRET = "{{ _ctl_ws_secret }}"

  execution_environments.py: |
    GLOBAL_JOB_EXECUTION_ENVIRONMENTS = [
        {'name': 'ACE EE (latest)', 'image': '{{ _ee_image }}'},
    ]
    CONTROL_PLANE_EXECUTION_ENVIRONMENT = "{{ _ee_image }}"
