---
# Django settings for the controller. AWX reads everything in
# /etc/tower/conf.d, so this is mounted there rather than merged into a single
# file -- which is also what lets the gateway settings sit beside the base ones.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-controller-settings
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  settings.py: |
    import os
    import socket
    from django_auth_ldap.config import *

    def get_secret():
        if os.path.exists("/etc/tower/SECRET_KEY"):
            return open('/etc/tower/SECRET_KEY', 'rb').read().strip()

    ADMINS = ()
    STATIC_ROOT = '/var/lib/awx/public/static'
    STATIC_URL = '/static/'
    PROJECTS_ROOT = '/var/lib/awx/projects'
    JOBOUTPUT_ROOT = '/var/lib/awx/job_status'

    IS_K8S = True
    SECRET_KEY = get_secret()
    ALLOWED_HOSTS = ['*']
    INTERNAL_API_URL = 'http://127.0.0.1:{{ _ctl_web_port }}'

    # No chroot: the job already runs in its own container.
    AWX_PROOT_ENABLED = False
    AWX_AUTO_DEPROVISION_INSTANCES = True

    CLUSTER_HOST_ID = socket.gethostname()
    SYSTEM_UUID = os.environ.get('MY_POD_UID', '00000000-0000-0000-0000-000000000000')

    CSRF_COOKIE_SECURE = False
    SESSION_COOKIE_SECURE = False
    USE_X_FORWARDED_PORT = True
    BROADCAST_WEBSOCKET_PORT = {{ _ctl_web_port }}
    BROADCAST_WEBSOCKET_PROTOCOL = 'http'
    RECEPTOR_LOG_LEVEL = '{{ controller.receptor_log_level | default('info') }}'

    # The platform's front door owns identity. The controller trusts JWTs the
    # gateway signs and resolves users against it as the resource server; the
    # URL prefix is what makes /api/controller/ work behind envoy.
    ANSIBLE_BASE_JWT_KEY = '{{ _gw_internal_url }}'
    ANSIBLE_BASE_JWT_VALIDATE_CERT = False
    RESOURCE_SERVER = {'URL': '{{ _gw_internal_url }}', 'SECRET_KEY': '{{ _service_secret_map['controller'] }}', 'VALIDATE_HTTPS': False}
    OPTIONAL_API_URLPATTERN_PREFIX = 'controller'

    # Jobs run as pods in this cluster, in our own execution environment.
    AWX_CONTAINER_GROUP_DEFAULT_IMAGE = '{{ _ee_image }}'
{% for s in controller.extra_settings | default([]) %}
    {{ s.setting }} = {{ s.value }}
{% endfor %}
