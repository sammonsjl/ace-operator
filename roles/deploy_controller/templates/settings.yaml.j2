---
# Django settings for the controller. AWX reads everything in
# /etc/tower/conf.d, so this is mounted there rather than merged into a single
# file -- which is also what lets the gateway settings sit beside the base ones.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-controller-settings
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  settings.py: |
    import os
    import socket
    from django_auth_ldap.config import *

    def get_secret():
        if os.path.exists("/etc/tower/SECRET_KEY"):
            return open('/etc/tower/SECRET_KEY', 'rb').read().strip()

    ADMINS = ()
    STATIC_ROOT = '/var/lib/awx/public/static'
    STATIC_URL = '/static/'
    PROJECTS_ROOT = '/var/lib/awx/projects'
    JOBOUTPUT_ROOT = '/var/lib/awx/job_status'

    IS_K8S = True
    SECRET_KEY = get_secret()
    ALLOWED_HOSTS = ['*']
    INTERNAL_API_URL = 'http://127.0.0.1:{{ _ctl_web_port }}'

    # No chroot: the job already runs in its own container.
    AWX_PROOT_ENABLED = False
    AWX_AUTO_DEPROVISION_INSTANCES = True

    CLUSTER_HOST_ID = socket.gethostname()
    SYSTEM_UUID = os.environ.get('MY_POD_UID', '00000000-0000-0000-0000-000000000000')

    CSRF_COOKIE_SECURE = False
    SESSION_COOKIE_SECURE = False
    USE_X_FORWARDED_PORT = True
    BROADCAST_WEBSOCKET_PORT = {{ _ctl_web_port }}
    BROADCAST_WEBSOCKET_PROTOCOL = 'http'
    RECEPTOR_LOG_LEVEL = '{{ controller.receptor_log_level | default('info') }}'

    # The platform's front door owns identity. The controller trusts JWTs the
    # gateway signs and resolves users against it as the resource server; the
    # URL prefix is what makes /api/controller/ work behind envoy.
    ANSIBLE_BASE_JWT_KEY = '{{ _gw_internal_url }}'
    ANSIBLE_BASE_JWT_VALIDATE_CERT = False
    RESOURCE_SERVER = {'URL': '{{ _gw_internal_url }}', 'SECRET_KEY': '{{ _service_secret_map['controller'] }}', 'VALIDATE_HTTPS': False}
    OPTIONAL_API_URLPATTERN_PREFIX = 'controller'

    # Jobs run as pods in this cluster, in our own execution environment.
    AWX_CONTAINER_GROUP_DEFAULT_IMAGE = '{{ _ee_image }}'

    # ---- Subscription state, completed for an open licence.
    #
    # AWX picks OpenLicense when the product is AWX, and OpenLicense.validate()
    # returns four keys: license_type, valid_key, subscription_name,
    # product_name. That predates the platform console, which reads the same
    # dict and branches on `compliant`:
    #
    #     compliant ? (time_remaining < 15 days ? "expires in N days" : ok)
    #               : "Your subscription is out of compliance."
    #
    # A missing key is falsy, so an open AWX lands in the else and the console
    # shows a permanent red out-of-compliance banner. Nothing is actually out
    # of compliance -- there is no subscription to be out of compliance with --
    # so the fix is to answer the question the console is asking rather than to
    # hide its banner: an open licence is compliant and does not expire.
    #
    # Patched here rather than in the image so it stays visible and revertible,
    # and because the licensing module imports cleanly at settings-load time
    # (its only Django import is the lazy settings proxy).
    def _ace_complete_open_license():
        from awx.main.utils.licensing import OpenLicense

        if getattr(OpenLicense, '_ace_patched', False):
            return
        _upstream_validate = OpenLicense.validate
        # Far enough out that the console's 15-day warning never fires, and
        # obviously synthetic to anyone who reads it.
        _forever = 100 * 365 * 24 * 60 * 60

        def validate(self):
            attrs = _upstream_validate(self)
            attrs.update(
                compliant=True,
                date_expired=False,
                date_warning=False,
                time_remaining=_forever,
                grace_period_remaining=_forever,
                trial=False,
            )
            return attrs

        OpenLicense.validate = validate
        OpenLicense._ace_patched = True

    _ace_complete_open_license()
    del _ace_complete_open_license

    # ---- Legacy organization role names on the ?role_level= filter.
    #
    # The console still asks questions like
    #   GET /api/controller/v2/organizations/?role_level=notification_admin_role
    # to decide which tabs to show. Those are pre-DAB role names. AWX kept a
    # compatibility table for exactly this -- awx.main.constants
    # .org_role_to_permission maps notification_admin_role to
    # add_notificationtemplate, and eight more besides -- but only the
    # serializer and the Role shim consult it. The ?role_level= filter goes
    # straight to Organization.access_ids_qs, which hands the name to DAB, and
    # DAB raises "The permission notification_admin_role is not valid for
    # model organization". The filter turns that into a 400, and the console
    # surfaces the raised text as the page error.
    #
    # So this applies AWX's own table on the one path that skips it. It is not
    # new policy: the mapping, and the intent behind it, are upstream's.
    #
    # Deferred to class_prepared because the patch needs the model class, and
    # nothing under awx.main.models can be imported while settings are still
    # being built.
    from django.db.models.signals import class_prepared as _ace_class_prepared

    def _ace_translate_legacy_org_roles(sender, **kwargs):
        if sender.__name__ != 'Organization' or sender._meta.app_label != 'main':
            return
        if getattr(sender, '_ace_role_level_patched', False):
            return

        from awx.main.constants import org_role_to_permission

        _upstream_access_ids_qs = sender.access_ids_qs

        def access_ids_qs(cls, actor, codename='view', **kwargs):
            # Unmapped names pass through untouched, so modern codenames like
            # 'view' and 'change_organization' behave exactly as before.
            return _upstream_access_ids_qs(actor, org_role_to_permission.get(codename, codename), **kwargs)

        sender.access_ids_qs = classmethod(access_ids_qs)
        sender._ace_role_level_patched = True

    _ace_class_prepared.connect(_ace_translate_legacy_org_roles, dispatch_uid='ace-legacy-org-roles')
{% for s in controller.extra_settings | default([]) %}
    {{ s.setting }} = {{ s.value }}
{% endfor %}
