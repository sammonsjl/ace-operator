---
# The task pod launches container-group jobs as pods in its own namespace and
# reads their logs back, so it needs more than the default ServiceAccount.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ _name }}-controller
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ _name }}-controller
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch, create, update, patch, delete]
  - apiGroups: [""]
    resources: [pods/log]
    verbs: [get]
  - apiGroups: [""]
    resources: [pods/attach]
    verbs: [create]
  - apiGroups: [""]
    resources: [secrets]
    verbs: [get, create, delete]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ _name }}-controller
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ _name }}-controller
subjects:
  - kind: ServiceAccount
    name: {{ _name }}-controller
    namespace: {{ _namespace }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ _name }}-controller-service
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  selector:
    app.kubernetes.io/name: {{ _name }}-controller-web
  ports:
    # Plain http on 80: envoy reaches this inside the cluster, and the
    # gateway's service node is registered against exactly this name and port.
    - name: http
      port: 80
      targetPort: {{ _ctl_web_port }}
