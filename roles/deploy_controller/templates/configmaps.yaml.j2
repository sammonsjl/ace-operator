---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ _name }}-controller-config
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
data:
  # Redis is a sidecar on a unix socket rather than a service: the controller
  # talks to its own cache and nothing else needs to reach it.
  redis.conf: |
    unixsocket /var/run/redis/redis.sock
    unixsocketperm 777
    port 0
    bind 127.0.0.1

  uwsgi.ini: |
    [uwsgi]
    socket = 127.0.0.1:8050
    chdir = /var/lib/awx
    module = awx.wsgi:application
    home = /var/lib/awx/venv/awx
    vacuum = True
    processes = 5
    harakiri = 120
    no-orphans = True
    master = True
    max-requests = 1000
    master-fifo = /var/lib/awx/awxfifo
    lazy-apps = True
    listen = 128
    buffer-size = 32768

  nginx.conf: |
    worker_processes 1;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }
    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;
      sendfile on;
      # The pid and every temp path move under /tmp because the container runs
      # as a non-root uid that cannot write nginx's defaults under /var.
      client_body_temp_path /tmp/client_body;
      proxy_temp_path /tmp/proxy;
      fastcgi_temp_path /tmp/fastcgi;
      uwsgi_temp_path /tmp/uwsgi;
      scgi_temp_path /tmp/scgi;
      map $http_upgrade $connection_upgrade { default upgrade; '' close; }
      server {
        listen {{ _ctl_web_port }} default_server;
        client_max_body_size 5m;
        location /static/ { alias /var/lib/awx/public/static/; }
        location /websocket {
          proxy_pass http://127.0.0.1:8051;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade;
          proxy_set_header Host $http_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        location / {
          uwsgi_read_timeout 120s;
          uwsgi_pass 127.0.0.1:8050;
          include /etc/nginx/uwsgi_params;
          proxy_set_header X-Forwarded-Port 443;
          uwsgi_param HTTP_X_FORWARDED_PORT 443;
        }
      }
    }

  receptor.conf: |
    ---
    # local-only, with no listener. There is no mesh here: jobs run as pods in
    # this cluster through the kubernetes work types below, not on remote
    # execution nodes.
    #
    # This is not cosmetic. AWX gates its lost-instance reaper on receptor
    # having a routing table, and a node that listens but peers with nobody
    # reports an empty one -- so the task log fills with
    #   Mesh stability gate: routing table empty, deferring peer-judgment
    # every 60s and instances from replaced pods are never deprovisioned,
    # leaving dead pods advertising capacity the scheduler will try to use.
    - local-only: null
    - node:
        id: HOSTNAME
    - log-level: {{ controller.receptor_log_level | default('info') }}
    - control-service:
        service: control
        filename: /var/run/receptor/receptor.sock
        permissions: 0660
    - work-command:
        worktype: local
        command: ansible-runner
        params: worker
        allowruntimeparams: true
    # Container-group execution submits work of these two types. Without them
    # receptor accepts the job and then refuses it:
    #   Failed to start work unit: unknown work type kubernetes-incluster-auth
    # incluster uses the pod's own ServiceAccount, which is why the task pod
    # carries a Role that can create pods and read their logs.
    - work-kubernetes:
        worktype: kubernetes-incluster-auth
        authmethod: incluster
        allowruntimeauth: true
        allowruntimepod: true
        allowruntimeparams: true
    # runtime is the same thing with credentials supplied by the job, for
    # container groups pointed at a cluster other than this one.
    - work-kubernetes:
        worktype: kubernetes-runtime-auth
        authmethod: runtime
        allowruntimeauth: true
        allowruntimepod: true
        allowruntimeparams: true
