---
# Vendor renders AutomationHub; we render Galaxy, the upstream kind served by
# galaxy-operator. That operator is GPLv2+ — creating its CRs is ordinary API
# use and carries no licence obligation on this repo.
apiVersion: galaxy.ansible.com/v1beta1
kind: Galaxy
metadata:
  name: {{ _name }}-hub
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  image: {{ _hub_image.split(':')[0] }}
  image_version: {{ _hub_image.split(':')[-1] }}
  image_pull_policy: {{ image_pull_policy | default('IfNotPresent') }}

  # pulp shares an artifact volume across api, content and worker, so this PVC
  # is ReadWriteMany — which the usual local-path default cannot provision.
  # Left unset it binds nothing and every hub pod sits Pending with no event on
  # the pod to say why; the reason is on the PVC.
  file_storage_storage_class: {{ hub.storage_class | default('nfs-csi') }}
  file_storage_size: {{ hub.storage_size | default('20Gi') }}
  file_storage_access_mode: ReadWriteMany

  postgres_configuration_secret: {{ _name }}-hub-pg
  admin_password_secret: {{ _name }}-admin-password
  db_fields_encryption_secret: {{ _name }}-db-fields-encryption

  api:
    replicas: {{ hub.replicas | default(1) }}
  content:
    replicas: {{ hub.replicas | default(1) }}
  worker:
    replicas: {{ hub.replicas | default(1) }}

  # ace-hub forces django-ansible-base to the ref the gateway builds against,
  # so the JWT dialect matches. If hub starts rejecting gateway tokens with a
  # missing-claim error, that pin is the place to look, not this CR.
  #
  # There is no resource_server field on this CRD -- unlike AWX and EDA, the
  # only way in is pulp_settings, whose keys are upper-cased into settings.py.
  # An earlier resource_server: block here was accepted by kubectl and then
  # dropped on the floor, which is why the hub trusted no gateway JWT at all
  # and post_install died with 401 Authentication credentials were not
  # provided on /api/galaxy/service-index/metadata/.
  #
  # The renderer is `value | to_json` for anything that is not a bare True or
  # False, so a nested boolean would emit JSON's `false` into a Python file.
  # Pointing at the gateway's internal http Service sidesteps that: there is no
  # TLS on 8446, so there is no VALIDATE_HTTPS to set.
  pulp_settings:
    ansible_base_jwt_key: "http://{{ _name }}-gateway.{{ _namespace }}.svc:{{ _gw_nginx_port }}"
    resource_server:
      URL: "http://{{ _name }}-gateway.{{ _namespace }}.svc:{{ _gw_nginx_port }}"
      SECRET_KEY: "{{ _service_secret_map['hub'] }}"
