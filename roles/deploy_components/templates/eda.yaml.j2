---
# EDA is the one kind whose name is the same upstream and downstream, so this
# template is the closest of the three to the vendor's own.
#
# Field names here are the *upstream* eda-server-operator's, which differ from
# the vendor's in several places. Its CRD sets x-kubernetes-preserve-unknown-
# fields, so a wrong name is accepted silently and then ignored -- every key
# below was checked against the CRD schema and the operator's own role defaults.
apiVersion: eda.ansible.com/v1alpha1
kind: EDA
metadata:
  name: {{ _name }}-eda
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  image: {{ _eda_image.split(':')[0] }}
  image_version: {{ _eda_image.split(':')[-1] }}
  image_pull_policy: {{ image_pull_policy | default('IfNotPresent') }}

  # We don't build an eda-ui image -- the gateway serves the platform console,
  # and EDA's own UI would only duplicate it behind a second route.
  ui_disabled: true

  api:
    replicas: {{ eda.replicas | default(1) }}

  # Required by the CRD. EDA appends /api/v2/ to this itself, so it must be the
  # controller's own Service and not the gateway's /api/controller/ prefix,
  # which would resolve to /api/controller/api/v2/.
  automation_server_url: {{ eda.automation_server_url | default('http://' ~ _name ~ '-controller-service.' ~ _namespace ~ '.svc') }}
  automation_server_ssl_verify: "no"

  # Nested, not a top-level database_secret: the operator reads
  # database.database_secret, and the top-level name that appears in its
  # postgres role defaults is the role's own internal variable. Getting this
  # wrong is silent -- the CRD preserves unknown fields, the operator sees no
  # external database, and it stands up a managed postgres StatefulSet
  # alongside the cluster's real one.
  # eda.configmap.yaml.j2 references public_base_url with a bare truthiness
  # test rather than `is defined`, and nothing in the operator ever sets it,
  # so leaving it out fails the reconcile at "Apply ConfigMap resources"
  # with an undefined-variable error. It is the platform's public URL --
  # what EDA hands out as the base for webhooks and event streams.
  public_base_url: {{ gateway.external_url | default('https://' ~ _name ~ '-gateway') }}

  database:
    database_secret: {{ _name }}-eda-pg
  # Deliberately not set: ace-db-fields-encryption is the controller's, and its
  # secret_key is that component's Django SECRET_KEY. Left unset, the operator
  # generates ace-eda-db-fields-encryption-secret so EDA gets its own.
  admin_password_secret: {{ _name }}-admin-password

  # This operator has no resource_server field. Its only injection point is
  # extra_settings, which lands in the -env-properties ConfigMap and reaches
  # every pod via envFrom -- so these must carry EDA's dynaconf prefix
  # themselves, with __ for nesting.
  extra_settings:
    - setting: EDA_ANSIBLE_BASE_JWT_KEY
      value: "http://{{ _name }}-gateway.{{ _namespace }}.svc:{{ _gw_nginx_port }}"
    - setting: EDA_ANSIBLE_BASE_JWT_VALIDATE_CERT
      value: "false"
    - setting: EDA_ANSIBLE_BASE_JWT_REDIRECT_TYPE
      value: "eda"
    - setting: EDA_RESOURCE_SERVER__URL
      value: "http://{{ _name }}-gateway.{{ _namespace }}.svc:{{ _gw_nginx_port }}"
    # NOTE: this is a ConfigMap, not a Secret. envFrom+configMapRef is the only
    # path this operator offers, so the service secret is as exposed as the
    # ConfigMap is. It is the same value already held in {{ _name }}-service-secrets.
    - setting: EDA_RESOURCE_SERVER__SECRET_KEY
      value: "{{ _service_secret_map['eda'] }}"
    - setting: EDA_RESOURCE_SERVER__VALIDATE_HTTPS
      value: "false"
{% for s in eda.extra_settings | default([]) %}
    - setting: {{ s.setting }}
      value: "{{ s.value }}"
{% endfor %}
