---
# galaxy-operator installs a default-deny NetworkPolicy and per-tier policies
# that admit only pods labelled app.kubernetes.io/managed-by in
# (galaxy-operator, aap-operator). The ACE gateway is managed-by ace-operator,
# so envoy cannot reach the hub at all and every /api/galaxy/ request is a 503
# — with the hub itself perfectly healthy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ _name }}-hub-from-gateway
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: In
        values: [api, content-server, webserver]
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: {{ _name }}-gateway
---
# galaxy-operator's per-tier egress policy for the web tier assumes OpenShift:
# its only DNS rule allows namespace "openshift-dns" on port 5353. On vanilla
# Kubernetes that namespace does not exist and DNS is kube-system/kube-dns on
# 53, so the web pods resolve nothing -- and because their egress rules list no
# catch-all (the api and content tiers get one, the web tier does not), the
# wait-for-content-service init container blocks forever on a name lookup while
# the content service it is waiting for is perfectly healthy.
#
# Egress rules union across policies, so this grants the missing DNS path
# without touching the operator's own policy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ _name }}-hub-dns
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: In
        values: [api, content-server, webserver, worker]
  policyTypes: [Egress]
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
