---
# galaxy-operator installs a default-deny NetworkPolicy and per-tier policies
# that admit only pods labelled app.kubernetes.io/managed-by in
# (galaxy-operator, aap-operator). The ACE gateway is managed-by ace-operator,
# so envoy cannot reach the hub at all and every /api/galaxy/ request is a 503
# — with the hub itself perfectly healthy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ _name }}-hub-from-gateway
  namespace: {{ _namespace }}
  labels:
{{ _labels | to_nice_yaml(indent=2) | indent(4, True) }}
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: In
        values: [api, content-server, webserver]
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: {{ _name }}-gateway
